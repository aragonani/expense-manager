<!DOCTYPE html>
<html>
<head>
    <title>Edit Expense</title>
</head>
<body>
    <h1>Edit Expense</h1>
    <form action="/expense/<%= expense._id %>/update" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= expense.title %>" required>
        </div>
        <br>
        <div>
            <label for="amount">Amount:</label>
            <input type="number" id="amount" name="amount" value="<%= expense.amount %>" required>
        </div>
        <br>
        <div>
            <label for="category">Category:</label>
            <input type="text" id="category" name="category" value="<%= expense.category %>">
        </div>
        <br>
        <div>
            <label for="date">Date:</label>
            <input type="date" id="date" name="date" value="<%= expense.date ? (new Date(expense.date)).toISOString().split('T')[0] : '' %>">
        </div>
        <br>
        <button type="submit">Update Expense</button>
    </form>
    <br>
    <a href="/expense"><button>Back to Expenses</button></a>
</body>
</html>
